+    if (lse_out && parallel_blocks == 1) {
+        dst_tmp_meta.alloc(ggml_nrows(KQV));
+    }
+
     float scale         = 1.0f;
     float max_bias      = 0.0f;
     float logit_softcap = 0.0f;
@@ -1373,5 +1400,9 @@ void launch_fattn(
