+// KERYX_RPC_MANIFEST: TSV "name<TAB>nbytes<TAB>fnv1a64hex"; tensors listed there are set by
+// hash without reading local bytes (the local file may hold no data for them).
+struct keryx_manifest_entry { size_t nbytes; uint64_t hash; };
+static const std::unordered_map<std::string, keryx_manifest_entry> & keryx_rpc_manifest() {
+    static std::unordered_map<std::string, keryx_manifest_entry> m;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded = true;
+        const char * path = std::getenv("KERYX_RPC_MANIFEST");
+        if (path) {
+            std::ifstream ifs(path);
+            std::string name, nbytes, hash;
+            while (std::getline(ifs, name, '\t') && std::getline(ifs, nbytes, '\t') && std::getline(ifs, hash)) {
+                m[name] = { (size_t) std::stoull(nbytes), std::stoull(hash, nullptr, 16) };
+            }
+            GGML_LOG_INFO("[keryx] rpc manifest '%s': %zu tensors\n", path, m.size());
+        }
+    }
+    return m;
+}
