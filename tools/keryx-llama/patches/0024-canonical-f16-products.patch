+// Leaves and ubatch sizes of positions [first, first + n).
+extern "C" int ggml_cuda_q8c_read_range(int device, uint32_t first, uint32_t n, uint8_t * leaves, size_t leaves_cap,
+                                        uint32_t * ubatch, size_t ubatch_cap) {
+    if (device < 0 || device >= Q8C_MAX_DEVICES || !q8c_devs[device].on || !leaves || !ubatch) {
+        return -1;
+    }
+    q8c_scoped_device sd(device);
+    if (!sd.ok) {
+        return -2;
+    }
+    q8c_dev & s = q8c_devs[device];
+    cudaDeviceSynchronize();
+    uint32_t pos = 0, overflow = 0;
+    if (cudaMemcpyFromSymbol(&pos, q8c_pos_base, 4) != cudaSuccess || cudaMemcpyFromSymbol(&overflow, q8c_overflow, 4) != cudaSuccess) {
+        return -3;
+    }
+    if (overflow || s.short_of_stage || first > pos || n > pos - first) {
+        return -5;
+    }
+    const size_t need = (size_t) n*s.nl*32;
+    if (leaves_cap < need || ubatch_cap < n) {
+        return -6;
+    }
+    memcpy(leaves, (const uint8_t *) s.h_leaves + (size_t) first*s.nl*32, need);
+    memcpy(ubatch, (const uint32_t *) s.h_ubatch + first, (size_t) n*4);
+    return 0;
+}
