+// Moves the trace to position `pos` and clears the leaves of positions [pos, pos + n).
+extern "C" int ggml_cuda_q8c_set_pos(int device, uint32_t pos, uint32_t n) {
+    if (device < 0 || device >= Q8C_MAX_DEVICES || !q8c_devs[device].on) {
+        return -1;
+    }
+    q8c_scoped_device sd(device);
+    if (!sd.ok) {
+        return -2;
+    }
+    q8c_dev & s = q8c_devs[device];
+    if (pos > s.max_pos || n > s.max_pos - pos) {
+        return -5;
+    }
+    const uint32_t zero = 0;
+    cudaDeviceSynchronize();
+    memset((uint8_t *) s.h_leaves + (size_t) pos*s.nl*32, 0, (size_t) n*s.nl*32);
+    memset((uint32_t *) s.h_ubatch + pos, 0, (size_t) n*4);
+    s.short_of_stage = false;
+    if (cudaMemcpyToSymbol(q8c_pos_base, &pos, 4) != cudaSuccess || cudaMemcpyToSymbol(q8c_overflow, &zero, 4) != cudaSuccess) {
+        return -3;
+    }
+    return 0;
+}
