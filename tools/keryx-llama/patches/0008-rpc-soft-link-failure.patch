 // macro for nicer error messages on server crash
 #define RPC_STATUS_ASSERT(x) if (!(x)) GGML_ABORT("Remote RPC server crashed or returned malformed response")
 
+// Client side: a link that fails mid-request is reported, not fatal. The next graph compute
+// fails, llama returns an error, and the caller drops the request.
+static std::atomic<bool> keryx_rpc_link_failed{false};
+static void keryx_rpc_mark_failed(const char * where) {
+    if (!keryx_rpc_link_failed.exchange(true)) {
+        GGML_LOG_ERROR("[keryx] rpc link failed in %s: remote gone or malformed response\n", where);
+    }
+}
+#define RPC_STATUS_SOFT(x, ...) if (!(x)) { keryx_rpc_mark_failed(__func__); return __VA_ARGS__; }
+
+void ggml_backend_rpc_reset_failure(void) { keryx_rpc_link_failed = false; }
+bool ggml_backend_rpc_link_failed(void) { return keryx_rpc_link_failed; }
+
