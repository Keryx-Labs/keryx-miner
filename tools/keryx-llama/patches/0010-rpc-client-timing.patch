+// Client side: wall time blocked in socket I/O per endpoint, by command class. A graph compute is
+// sent without waiting, so a shard's compute time shows up in the next get_tensor on its socket.
+enum keryx_rpc_class { KERYX_RPC_COMPUTE = 0, KERYX_RPC_GET = 1, KERYX_RPC_SET = 2, KERYX_RPC_OTHER = 3 };
+struct keryx_rpc_stat {
+    std::string endpoint;
+    std::atomic<uint64_t> ns[4]{};
+    std::atomic<uint64_t> calls{0};
+};
+static std::mutex keryx_rpc_stats_mutex;
+static std::deque<keryx_rpc_stat> keryx_rpc_stats;
+static std::unordered_map<const socket_t *, keryx_rpc_stat *> keryx_rpc_stat_by_sock;
+
+static void keryx_rpc_stats_track(const std::string & endpoint, const socket_t * sock) {
+    std::lock_guard<std::mutex> lock(keryx_rpc_stats_mutex);
+    keryx_rpc_stat * stat = nullptr;
+    for (auto & s : keryx_rpc_stats) {
+        if (s.endpoint == endpoint) { stat = &s; break; }
+    }
+    if (!stat) {
+        keryx_rpc_stats.emplace_back();
+        stat = &keryx_rpc_stats.back();
+        stat->endpoint = endpoint;
+    }
+    keryx_rpc_stat_by_sock[sock] = stat;
+}
+
+static keryx_rpc_stat * keryx_rpc_stat_for(const socket_t * sock) {
+    std::lock_guard<std::mutex> lock(keryx_rpc_stats_mutex);
+    auto it = keryx_rpc_stat_by_sock.find(sock);
+    return it == keryx_rpc_stat_by_sock.end() ? nullptr : it->second;
+}
+
+static int keryx_rpc_class_of(int cmd);
+
+struct keryx_rpc_timer {
+    keryx_rpc_stat * stat;
+    int cls;
+    std::chrono::steady_clock::time_point t0;
+    keryx_rpc_timer(const socket_t * sock, int cmd)
+        : stat(keryx_rpc_stat_for(sock)), cls(keryx_rpc_class_of(cmd)), t0(std::chrono::steady_clock::now()) {}
+    ~keryx_rpc_timer() {
+        if (!stat) return;
+        const auto dt = std::chrono::steady_clock::now() - t0;
+        stat->ns[cls] += (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(dt).count();
+        stat->calls++;
+    }
+};
+
+void ggml_backend_rpc_stats_reset(void) {
+    std::lock_guard<std::mutex> lock(keryx_rpc_stats_mutex);
+    for (auto & s : keryx_rpc_stats) {
+        for (auto & n : s.ns) n = 0;
+        s.calls = 0;
+    }
+}
+
+size_t ggml_backend_rpc_stats_count(void) {
+    std::lock_guard<std::mutex> lock(keryx_rpc_stats_mutex);
+    return keryx_rpc_stats.size();
+}
+
+bool ggml_backend_rpc_stats_get(size_t i, const char ** endpoint, uint64_t * compute_ns, uint64_t * get_ns,
+                                uint64_t * set_ns, uint64_t * other_ns, uint64_t * calls) {
+    std::lock_guard<std::mutex> lock(keryx_rpc_stats_mutex);
+    if (i >= keryx_rpc_stats.size()) return false;
+    const keryx_rpc_stat & s = keryx_rpc_stats[i];
+    if (endpoint)   *endpoint   = s.endpoint.c_str();
+    if (compute_ns) *compute_ns = s.ns[KERYX_RPC_COMPUTE];
+    if (get_ns)     *get_ns     = s.ns[KERYX_RPC_GET];
+    if (set_ns)     *set_ns     = s.ns[KERYX_RPC_SET];
+    if (other_ns)   *other_ns   = s.ns[KERYX_RPC_OTHER];
+    if (calls)      *calls      = s.calls;
+    return true;
+}
