+int64_t ggml_backend_rpc_ping_us(const char * endpoint) {
+    auto sock = get_socket(endpoint);
+    if (sock == nullptr) {
+        return -1;
+    }
+    rpc_msg_get_device_memory_req request;
+    request.device = 0;
+    rpc_msg_get_device_memory_rsp response;
+    const auto t0 = std::chrono::steady_clock::now();
+    if (!send_rpc_cmd_raw(sock, RPC_CMD_GET_DEVICE_MEMORY, &request, sizeof(request), &response, sizeof(response))) {
+        keryx_rpc_mark_failed(__func__);
+        return -1;
+    }
+    return (int64_t)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+}
