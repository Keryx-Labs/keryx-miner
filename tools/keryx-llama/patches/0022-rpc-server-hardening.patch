+static bool keryx_is_retired_buffer(ggml_backend_buffer_t buffer) {
+    std::lock_guard<std::mutex> lock(keryx_resident_mutex);
+    if (keryx_ever_resident.find(buffer) == keryx_ever_resident.end()) {
