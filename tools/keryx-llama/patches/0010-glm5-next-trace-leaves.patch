+// Selection row of each token: the smallest finite score of its chosen pools, then the pools with
+// a finite score in increasing order, then Q8C_NONE up to `n_slots`.
+static __global__ void q8c_sel_kernel(const int32_t * top, size_t top_nb1, int k, const float * score, size_t score_nb1,
+                                      int n_slots, uint8_t * out) {
+    const int t = blockIdx.x;
+    const int32_t * ti = (const int32_t *) ((const uint8_t *) top + (size_t) t*top_nb1);
+    const float *   sc = (const float *) ((const uint8_t *) score + (size_t) t*score_nb1);
+    uint32_t * row = (uint32_t *) (out + (size_t) t*(4 + 4*(size_t) n_slots));
+    __shared__ float vmin[256];
+    __shared__ int   nfin;
+    if (threadIdx.x == 0) {
+        nfin = 0;
+    }
+    __syncthreads();
+    float m = INFINITY;
+    for (int i = threadIdx.x; i < k; i += blockDim.x) {
+        const float v = sc[ti[i]];
+        if (isfinite(v) && v > -__FLT_MAX__) {
+            m = fminf(m, v);
+            atomicAdd(&nfin, 1);
+        }
+    }
+    vmin[threadIdx.x] = m;
+    __syncthreads();
+    for (int w = blockDim.x/2; w > 0; w >>= 1) {
+        if (threadIdx.x < w) {
+            vmin[threadIdx.x] = fminf(vmin[threadIdx.x], vmin[threadIdx.x + w]);
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        const float thr = isfinite(vmin[0]) ? vmin[0] : 0.0f;
+        memcpy(&row[0], &thr, 4);
+    }
+    for (int i = threadIdx.x; i < k; i += blockDim.x) {
+        const int32_t p = ti[i];
+        if (!(isfinite(sc[p]) && sc[p] > -__FLT_MAX__)) {
+            continue;
+        }
+        int rank = 0;
+        for (int j = 0; j < k; ++j) {
+            rank += isfinite(sc[ti[j]]) && sc[ti[j]] > -__FLT_MAX__ && ti[j] < p;
+        }
+        row[1 + rank] = (uint32_t) p;
+    }
+    for (int i = nfin + threadIdx.x; i < n_slots; i += blockDim.x) {
+        row[1 + i] = Q8C_NONE;
+    }
+}
+
+// Selection leaf of an indexer top-k node named `indexer_top_k_raw-<layer>`, or -1.
+static int q8c_sel_leaf(const q8c_dev & s, const char * name, uint32_t * n_slots) {
+    static const char key[] = "indexer_top_k_raw-";
+    if (s.n_sel == 0 || strncmp(name, key, sizeof(key) - 1) != 0) {
+        return -1;
+    }
+    char * end = nullptr;
+    const unsigned long il = strtoul(name + sizeof(key) - 1, &end, 10);
+    if (*end != '\0' || il >= s.sel_of_layer.size() || s.sel_of_layer[il] < 0) {
+        return -1;
+    }
+    *n_slots = s.sel_top[il];
+    return (int) (2*s.n_products + (s.ple ? 3 : 2)*s.n_layers + s.n_router + (s.ple ? 2 : 0)) + s.sel_of_layer[il];
+}
+
+static bool q8c_sel(const ggml_tensor * node, cudaStream_t stream) {
+    q8c_dev * s = q8c_current();
+    if (!s || !s->on || node->op != GGML_OP_TOP_K || node->type != GGML_TYPE_I32) {
+        return false;
+    }
+    uint32_t n_slots = 0;
+    const int leaf = q8c_sel_leaf(*s, node->name, &n_slots);
+    if (leaf < 0) {
+        return false;
+    }
+    const ggml_tensor * score = node->src[0];
+    const int64_t k = node->ne[0], n_tokens = ggml_nrows(node);
+    if (!score || score->type != GGML_TYPE_F32 || ggml_nrows(score) != n_tokens || k > (int64_t) n_slots || k > score->ne[0]
+        || node->nb[0] != sizeof(int32_t) || score->nb[0] != sizeof(float)) {
+        return true;
+    }
+    const size_t row_bytes = 4 + 4*(size_t) n_slots;
+    const size_t need = row_bytes*(size_t) n_tokens;
+    if (need > s->sel_cap) {
+        if (s->sel_buf) {
+            cudaFree(s->sel_buf);
+        }
+        s->sel_cap = 0;
+        if (cudaMalloc(&s->sel_buf, need) != cudaSuccess) {
+            s->sel_buf = nullptr;
+            return true;
+        }
+        s->sel_cap = need;
+    }
+    q8c_sel_kernel<<<(unsigned) n_tokens, 256, 0, stream>>>((const int32_t *) node->data, node->nb[1], (int) k,
+                                                           (const float *) score->data, score->nb[1], (int) n_slots, s->sel_buf);
+    const int shift = s->cur && (int64_t) s->cur->n_tokens > n_tokens ? (int) (s->cur->n_tokens - n_tokens) : 0;
+    ggml_cuda_q8c_out(s->sel_buf, n_tokens, (int64_t) row_bytes, leaf, shift, false, stream);
+    return true;
+}
