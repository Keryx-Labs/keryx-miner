+bool rpc_server::keryx_resident(const rpc_msg_keryx_resident_req & request, std::vector<uint8_t> & response) {
+    rpc_msg_keryx_resident_hdr hdr = {0, 0, 0, 0};
+    std::lock_guard<std::mutex> lock(keryx_resident_mutex);
+    const keryx_resident_set * set = nullptr;
+    for (const auto & r : keryx_residents) {
+        if (r.device == request.device) {
+            set = &r;
+            break;
+        }
+    }
+    if (set == nullptr) {
+        response.resize(sizeof(hdr));
+        memcpy(response.data(), &hdr, sizeof(hdr));
+        return true;
+    }
+    hdr.remote_ptr = reinterpret_cast<uint64_t>(set->buffer);
+    hdr.base_ptr   = reinterpret_cast<uint64_t>(ggml_backend_buffer_get_base(set->buffer));
+    hdr.size       = ggml_backend_buffer_get_size(set->buffer);
+    hdr.n_tensors  = (uint32_t) set->tensors.size();
+    response.resize(sizeof(hdr) + set->tensors.size() * sizeof(rpc_msg_keryx_resident_tensor));
+    memcpy(response.data(), &hdr, sizeof(hdr));
+    uint8_t * p = response.data() + sizeof(hdr);
+    for (size_t i = 0; i < set->tensors.size(); i++) {
+        rpc_msg_keryx_resident_tensor e;
+        memset(&e, 0, sizeof(e));
+        e.data   = set->tensors[i].data;
+        e.nbytes = set->tensors[i].nbytes;
+        snprintf(e.name, GGML_MAX_NAME, "%s", set->tensors[i].name.c_str());
+        memcpy(p + i * sizeof(e), &e, sizeof(e));
+    }
+    return true;
+}
