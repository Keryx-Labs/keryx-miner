+// KERYX resident weights: a buffer this process loaded itself, exposed to clients per device.
+// A client binds its tensors to it by name (RPC_CMD_KERYX_RESIDENT) instead of allocating a
+// buffer and pushing the bytes; the buffer is never freed or written through the protocol.
+struct keryx_resident_tensor {
+    std::string name;
+    uint64_t    data;
+    uint64_t    nbytes;
+};
+
+struct keryx_resident_set {
+    uint32_t                          device = 0;
+    ggml_backend_buffer_t             buffer = nullptr;
+    std::vector<keryx_resident_tensor> tensors;
+};
+
+static std::mutex keryx_resident_mutex;
+static std::vector<keryx_resident_set> keryx_residents;
+
+static bool keryx_is_resident_buffer(ggml_backend_buffer_t buffer) {
+    std::lock_guard<std::mutex> lock(keryx_resident_mutex);
+    for (const auto & r : keryx_residents) {
+        if (r.buffer == buffer) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void ggml_backend_rpc_set_resident(uint32_t device, ggml_backend_buffer_t buffer, size_t n_tensors,
+                                   const char ** names, const void ** datas, const size_t * nbytes) {
+    std::lock_guard<std::mutex> lock(keryx_resident_mutex);
+    for (size_t i = 0; i < keryx_residents.size(); ) {
+        if (keryx_residents[i].device == device) {
+            keryx_residents.erase(keryx_residents.begin() + i);
+        } else {
+            i++;
+        }
+    }
+    if (buffer == nullptr) {
+        return;
+    }
+    keryx_resident_set set;
+    set.device = device;
+    set.buffer = buffer;
+    for (size_t i = 0; i < n_tensors; i++) {
+        set.tensors.push_back({std::string(names[i]), reinterpret_cast<uint64_t>(datas[i]), (uint64_t) nbytes[i]});
+    }
+    keryx_residents.push_back(std::move(set));
+}
