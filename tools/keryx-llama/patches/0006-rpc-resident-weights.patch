+// KERYX: bind the tensors of `ctx` to the weights resident on the rpc device behind `buft`.
+// NULL when the server holds no resident weights for that device, or a tensor of `ctx` is
+// missing there or sized differently; the caller then allocates and loads as usual.
+ggml_backend_buffer_t ggml_backend_rpc_bind_resident(ggml_backend_buffer_type_t buft, struct ggml_context * ctx) {
+    if (buft == nullptr || buft->iface.get_name != ggml_backend_rpc_buffer_type_name) {
+        return nullptr;
+    }
+    ggml_backend_rpc_buffer_type_context * buft_ctx = (ggml_backend_rpc_buffer_type_context *)buft->context;
+    auto sock = get_socket(buft_ctx->endpoint);
+    if (sock == nullptr) {
+        return nullptr;
+    }
+    rpc_msg_keryx_resident_req request = {buft_ctx->device};
+    if (!send_rpc_cmd(sock, RPC_CMD_KERYX_RESIDENT, &request, sizeof(request))) {
+        return nullptr;
+    }
+    std::vector<uint8_t> response;
+    if (!recv_msg(sock, response) || response.size() < sizeof(rpc_msg_keryx_resident_hdr)) {
+        return nullptr;
+    }
+    rpc_msg_keryx_resident_hdr hdr;
+    memcpy(&hdr, response.data(), sizeof(hdr));
+    if (hdr.remote_ptr == 0 ||
+        response.size() != sizeof(hdr) + (size_t) hdr.n_tensors * sizeof(rpc_msg_keryx_resident_tensor)) {
+        return nullptr;
+    }
+    std::unordered_map<std::string, std::pair<uint64_t, uint64_t>> layout;
+    const uint8_t * p = response.data() + sizeof(hdr);
+    for (uint32_t i = 0; i < hdr.n_tensors; i++) {
+        rpc_msg_keryx_resident_tensor e;
+        memcpy(&e, p + (size_t) i * sizeof(e), sizeof(e));
+        e.name[GGML_MAX_NAME - 1] = 0;
+        layout.emplace(std::string(e.name), std::make_pair(e.data, e.nbytes));
+    }
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        auto it = layout.find(ggml_get_name(t));
+        if (it == layout.end() || it->second.second != (uint64_t) ggml_nbytes(t)) {
+            GGML_LOG_ERROR("[%s] tensor %s is not resident on %s\n", __func__, ggml_get_name(t), buft_ctx->name.c_str());
+            return nullptr;
+        }
+    }
+    ggml_backend_buffer_t buffer = ggml_backend_buffer_init(buft,
+        ggml_backend_rpc_buffer_interface,
+        new ggml_backend_rpc_buffer_context{sock, reinterpret_cast<void *>(hdr.base_ptr), hdr.remote_ptr},
+        hdr.size);
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+        t->buffer = buffer;
+        t->data   = reinterpret_cast<void *>(layout[ggml_get_name(t)].first);
+    }
+    return buffer;
+}
