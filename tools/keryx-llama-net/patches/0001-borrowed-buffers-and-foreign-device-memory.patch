+ggml_backend_buffer_t ggml_backend_buffer_borrow(ggml_backend_buffer_t buffer) {
+    GGML_ASSERT(buffer);
+    struct ggml_backend_buffer_i iface = buffer->iface;
+    iface.free_buffer = NULL;
+    ggml_backend_buffer_t view = ggml_backend_buffer_init(buffer->buft, iface, buffer->context, buffer->size);
+    view->usage = buffer->usage;
+    return view;
+}
